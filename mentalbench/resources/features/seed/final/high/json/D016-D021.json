                    },
                    "S066": {
                        "name": "Compulsions",
                        "categoty": "obsessive_compulsive_symptoms",
                        "description": "Repetitive behaviors or mental acts performed in response to an obsession or to prevent anxiety/distress; clearly excessive or not realistically connected.",
                        "subtypes": {
                            "Cleaning or Washing Compulsions": "Repetitive acts to remove contamination, such as hand washing, showering, or excessive cleaning.",
                            "Checking Compulsions": "Repeatedly checking items like door locks, gas stoves, or switches to prevent danger.",
                            "Ordering and Arranging Compulsions": "Organizing objects in a specific order or at a precise angle to reduce anxiety.",
                            "Mental Acts": "Mental rituals performed internally, such as praying, counting, or repeating specific words silently.",
                            "Repeating Rituals": "Repeating specific actions (e.g., standing up, passing through a door) a set number of times."
                        },
                        "examples": null
