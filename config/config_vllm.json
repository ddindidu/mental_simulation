{
    "llm": {
        "patient": {
            "provider": "vllm",
            "model": "Qwen/Qwen3.5-35B-A3B"
        },
        "doctor": {
            "provider": "vllm",
            "model": "Qwen/Qwen3.5-35B-A3B"
        },
        "vllm": {
            "base_url": "http://localhost:8001/v1",
            "timeout_seconds": 600
        },
        "openai": {
            "use_max_completion_tokens": "auto",
            "timeout_seconds": 600,
            "reasoning_completion_floor": 512
        }
    },
    "simulation": {
        "max_turns": 10
    },
    "patient": {
        "use_knowledge_graph": true,
        "disease_code": "D009",
        "difficulty_level": "medium",
        "kg_base_dir": "./mentalbench"
    },
    "generation": {
        "patient": {
            "default_max_new_tokens": 300,
            "alignment_max_new_tokens": 500,
            "temperature": 0.7,
            "top_p": 0.9,
            "do_sample": true
        },
        "doctor": {
            "default_max_new_tokens": 300,
            "inference_max_new_tokens": 400,
            "diagnosis_max_new_tokens": 600,
            "temperature": 0.7,
            "top_p": 0.9,
            "do_sample": true
        }
    },
    "server": {
        "host": "0.0.0.0",
        "port": 5000,
        "debug": false,
        "threaded": true
    },
    "debug": {
        "log_llm_messages": false,
        "log_openai_response": true
    }
}
